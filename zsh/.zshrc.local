# Added by LM Studio CLI (lms)
export PATH="$PATH:/home/vvaxis/.lmstudio/bin"
# End of LM Studio CLI section

[ -f ~/.config/vdirsyncer/credentials ] && source ~/.config/vdirsyncer/credentials

# Created by `pipx` on 2026-01-27 06:11:52
export PATH="$PATH:/home/vvaxis/.local/bin"

zstyle ':completion:*:commands' rehash on

export EDITOR=micro
export VISUAL=micro

# --- Swordfish boot sequence (first terminal only) ---
if [[ ! -f /tmp/.swordfish-booted-$UID ]]; then
    touch /tmp/.swordfish-booted-$UID
    fastfetch
    printf '\n\033[38;2;138;66;244m>>> INITIALIZING DECK TERMINAL...\033[0m\n'
    sleep 1
    printf '\033[38;2;138;66;244m>>> SYSTEMS CHECK: \033[38;2;5;203;13mALL NOMINAL\033[0m\n'
    sleep 1
    printf '\033[38;2;0;217;233m>>> SWORDFISH II — TERMINAL ONLINE\033[0m\n'
fi

# --- Swordfish narrative hooks ---

# Command not found
command_not_found_handler() {
    printf '\033[38;2;242;93;148m>>> UNKNOWN COMMAND: %s\033[0m\n' "$1" >&2
    return 127
}

# SSH "docking"
ssh() {
    printf '\033[38;2;138;66;244m>>> DOCKING WITH %s...\033[0m\n' "${@: -1}"
    command ssh "$@"
    printf '\033[38;2;88;91;112m>>> UNDOCKED\033[0m\n'
}

# --- Starship prompt ---
prompt off
eval "$(starship init zsh)"

# --- Zsh plugins ---

# Extra completions (just needs fpath, loaded before compinit by grml)
fpath=(/usr/share/zsh/site-functions $fpath)

# Autosuggestions (fish-like greyed-out suggestions)
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh 2>/dev/null

# History substring search (up/down arrows match typed prefix)
source /usr/share/zsh/plugins/zsh-history-substring-search/zsh-history-substring-search.zsh 2>/dev/null
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# Syntax highlighting (must be sourced last)
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh 2>/dev/null
