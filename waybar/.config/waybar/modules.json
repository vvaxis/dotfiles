{
    "hyprland/workspaces": {
         "disable-scroll": true,
         "active-only": false,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{name}",
         "format-icons": {
             "urgent": "",
             "active": "✦",
             "default": ""
         },
     },

"hyprland/window": {
    "format": "{}",
    "max-length": 20,
    "separate-outputs": true,
    "rewrite": {
        "(.*) — LibreWolf": "󰈹   $1",
        "LibreWolf": "󰈹   LibreWolf",
        "(.*)Discord(.*)": "󰙯   $1",
        "Spotify Premium": "   Spotify",
        "Steam": "󰓓   Steam",
        "": " 󰣇 ",
        "micro (.*)": "󰦨  $1",
        "WhatsApp": "   WhatsApp",
        "(.*)WhatsApp Business": "  WhatsApp $1"
    }
},
    
    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },

    
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },

    
    "tray": {
        "icon-size": 18,
        "spacing": 10,
        "show-passive-items": true,
         "icons": {
//           "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
         }
    },

    
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        "on-click-right": "~/.local/bin/open-calendar.sh",
        "on-click-middle": "xdg-open https://calendar.google.com/calendar/u/0/r"
    },

    
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false,
        "on-click": "toggle-scratchpad btop btop-scratchpad kitty --class btop-scratchpad -e btop"
    },

    
    "memory": {
        "format": "{}% ",
        "states": {
            "warning": 80,
            "critical": 90
        },
        "on-click": "toggle-scratchpad btop btop-scratchpad kitty --class btop-scratchpad -e btop"
    },

    
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "warning-threshold": 70,
        "critical-threshold": 85,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""],
        "on-click": "toggle-scratchpad btop btop-scratchpad kitty --class btop-scratchpad -e btop"
    },
    
    
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "{ipaddr}/{cidr}  ",
        "tooltip-format": "{ifname} via {gwaddr}  ",
        "format-linked": "{ifname} (No IP)  ",
        "format-disconnected": "Disconnected ⚠",
        "format-disabled": "Disabled",
        "on-click": "networkmanager_dmenu",    // abre o menu (rofi/wofi)
        "on-click-right": "nm-connection-editor",    // abre GUI avançada
        },

     "hyprland/language": {
         "format": "{}",
         "format-en": "󰌌 US",
         "format-pt": "󰌌 BR",
         "format-pt-br": "BR", // Caso o hyprland retorne pt-br minúsculo
         "on-click": "~/.local/bin/layout_toggle.sh" // Alterna rápido
     },
    
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 ",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "max-volume": 100,
        "scroll-step": 5
    },

    
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "format-connected-battery": "󰂱 {device_battery_percentage}%",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "on-click": "kitty -e bluetuith",
        "on-click-right": "bluetoothctl power toggle"
    },

    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜",
            "Playing": " ",
            "Paused": " "
        },
        "escape": true,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{markup_escape(title)}}\", \"tooltip\": \"{{playerName}}: {{markup_escape(title)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "on-click-right": "spotify"
        // "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },

	"custom/cava": {
	    "exec": "~/.local/bin/cava.sh",
	    "format": "{}",
	    "tooltip": false
	},
    
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "power-menu.sh"
    },

    "custom/dunst": {
        "exec": "~/.local/bin/dunst-waybar.sh",
        "return-type": "json",
        "interval": 2,
        "tooltip": true,
        "format": "<span size='16pt'>{icon}</span>",
        "format-icons": {
            "active": "󰂜",
            "muted": "󰪓"
        },
        "on-click": "dunstctl history-pop",
        "on-click-right": "dunstctl set-paused toggle"
    }
}
