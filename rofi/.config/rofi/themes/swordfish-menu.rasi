/**
 * Swordfish — tema único Rofi
 * Usado por: app launcher (drun), menus contextuais (dmenu via swordfish-menu)
 * Menus contextuais recebem posição dinâmica via -theme-str no wrapper.
 */

* {
    bg:         #010204;
    fg:         #c0caf5;
    accent:     #8a56dc;
    accent-alt: #47d6e3;
    border-c:   #4f46b5;
    warning:    #e56b99;
    success:    #05cb0d;

    font: "DepartureMono Nerd Font 12";
    text-color: @fg;
    background-color: transparent;
}

window {
    location: center;
    width: 40%;
    border: 1px solid;
    border-color: @border-c;
    border-radius: 0;
    background-color: rgba(1, 2, 4, 0.92);
    padding: 8px;
}

inputbar {
    children: [prompt, entry];
    background-color: transparent;
    border: 0px;
    padding: 4px 6px;
    spacing: 6px;
}

prompt {
    content: ">>>";
    text-color: @accent-alt;
    font: "DepartureMono Nerd Font Bold 10";
    vertical-align: 0.5;
}

entry {
    placeholder: "";
    background-color: transparent;
    text-color: @fg;
    cursor-color: @accent;
    cursor-width: 2px;
    blink: true;
}

listview {
    columns: 1;
    lines: 10;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
    border: 0px;
    background-color: transparent;
}

element {
    background-color: transparent;
    padding: 4px 8px;
    border: 0px;
}

element-text {
    text-color: @fg;
    vertical-align: 0.5;
}

element-icon {
    size: 20px;
    padding: 0 8px 0 0;
}

element selected {
    background-color: rgba(138, 86, 220, 0.18);
    text-color: @fg;
    border: 0px 0px 0px 2px;
    border-color: @accent;
}

button {
    background-color: transparent;
    text-color: @accent-alt;
    padding: 2px 5px;
}

button selected {
    background-color: rgba(71, 214, 227, 0.18);
    text-color: @fg;
}

message {
    background-color: transparent;
    border: 0px;
    padding: 4px;
}

textbox {
    text-color: @fg;
}
