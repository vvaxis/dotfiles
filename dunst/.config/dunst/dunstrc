[global]
    # Display
    monitor = 0
    follow = keyboard
    width = 350
    height = (0, 150)
    origin = top-right
    offset = (20, 10)
    notification_limit = 5
    
    # Aparência
    frame_width = 1
    frame_color = "#8a6bc4"
    separator_color = frame
    corner_radius = 0
    transparency = 15
    
    # Fonte e texto
    font = DepartureMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    
    # Comportamento
    sort = yes
    idle_threshold = 120
    show_age_threshold = 60
    sticky_history = yes
    history_length = 50
    
    # Ações
    mouse_left_click = close_current
    mouse_right_click = do_action, close_current
    mouse_middle_click = close_all
    
    # Ícones
    icon_position = left
    max_icon_size = 48
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true

    # Wayland
    layer = overlay
    force_xwayland = false

[urgency_low]
    background = "#1a1530"
    foreground = "#c0caf5"
    frame_color = "#585b70"
    timeout = 5

[urgency_normal]
    background = "#1a1530"
    foreground = "#c0caf5"
    frame_color = "#05cb0d"
    timeout = 10

[urgency_critical]
    background = "#1a1530"
    foreground = "#d97a9e"
    frame_color = "#d97a9e"
    timeout = 0
