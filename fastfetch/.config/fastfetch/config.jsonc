{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " /// ",
        "color": {
            "separator": "38;2;88;91;112",
            "keys": "38;2;138;66;244",
            "output": "38;2;192;202;245"
        }
    },
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/swordfish.png",
        "width": 40,
        "preserveAspectRatio": true,
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "output": "38;2;0;217;233"
            }
        },
        "separator",
        {
            "type": "os",
            "key": "HULL",
            "format": "{pretty-name} [{arch}]"
        },
        {
            "type": "kernel",
            "key": "CORE",
            "format": "{release}"
        },
        {
            "type": "cpu",
            "key": "ENGINE",
            "format": "{name} ({cores-physical}C/{cores-logical}T, {freq-max})"
        },
        {
            "type": "gpu",
            "key": "REACTOR",
            "format": "{name} [{type}]"
        },
        {
            "type": "memory",
            "key": "BANKS"
        },
        {
            "type": "disk",
            "key": "CARGO",
            "folders": "/"
        },
        {
            "type": "uptime",
            "key": "FLIGHT"
        },
        {
            "type": "packages",
            "key": "UPLINK",
            "format": "{pacman}"
        },
        {
            "type": "shell",
            "key": "DECK"
        },
        {
            "type": "localip",
            "key": "COMM",
            "format": "{ipv4} ({ifname})"
        },
        {
            "type": "terminal",
            "key": "VIEWPORT"
        },
        {
            "type": "wm",
            "key": "HELM",
            "format": "{pretty-name} [{protocol-name}]"
        },
        {
            "type": "display",
            "key": "DISPLAY",
            "format": "{width}x{height} @ {refresh-rate}Hz"
        }
    ]
}
