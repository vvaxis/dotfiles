#!/bin/bash
# swordfish-menu — contextual rofi dmenu positioned below the cursor
# Usage: echo "opt1\nopt2" | swordfish-menu "Prompt"

prompt="${1:->>>}"

cursor_x=$(hyprctl cursorpos -j 2>/dev/null | jq -r '.x // 0')
offset_x=$(( cursor_x - 130 ))
[ "$offset_x" -lt 0 ] && offset_x=0

rofi -dmenu \
    -p "$prompt" \
    -theme "swordfish-menu" \
    -theme-str "window { location: north west; width: 260px; x-offset: ${offset_x}px; y-offset: 8px; }"
